// Prisma schema — Mascotas (sitio de búsqueda de mascotas perdidas)
// Vercel + PostgreSQL · Prisma 7
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Auth (Better Auth) — no cambiar los nombres/campos base
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Perfil del anunciante
  phone      String?
  city       String?
  department String?
  role       Role      @default(USER)

  sessions  Session[]
  accounts  Account[]
  pets      Pet[]
  sightings Sighting[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Dominio: mascotas perdidas
// ─────────────────────────────────────────────────────────────

model Pet {
  id          String    @id @default(cuid())
  name        String
  species     Species
  breed       String?
  sex         Sex       @default(DESCONOCIDO)
  size        Size?
  color       String?
  ageMonths   Int?
  description String?
  hasChip     Boolean   @default(false)
  chipNumber  String?
  sterilized  Boolean?

  status PetStatus @default(PERDIDA)

  // Última ubicación conocida / dónde se perdió
  lastSeenAt DateTime?
  address    String?
  city       String?
  department String?
  lat        Float?
  lng        Float?

  // Contacto para avisos
  contactPhone    String?
  contactEmail    String?
  contactWhatsapp String?
  reward          String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  photos    PetPhoto[]
  sightings Sighting[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([status, species])
  @@index([department, city])
  @@index([ownerId])
  @@map("pet")
}

model PetPhoto {
  id        String   @id @default(cuid())
  url       String
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([petId])
  @@map("pet_photo")
}

/// Avistamiento: alguien vio a la mascota y deja el dato
model Sighting {
  id         String  @id @default(cuid())
  petId      String
  pet        Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  reporterName  String?
  reporterPhone String?
  description   String?
  photoUrl      String?

  seenAt     DateTime?
  address    String?
  city       String?
  department String?
  lat        Float?
  lng        Float?

  status    SightingStatus @default(PENDIENTE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([petId])
  @@index([status])
  @@map("sighting")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  USER
  MODERADOR
  ADMIN
}

enum Species {
  PERRO
  GATO
  OTRO
}

enum Sex {
  MACHO
  HEMBRA
  DESCONOCIDO
}

enum Size {
  CHICO
  MEDIANO
  GRANDE
}

enum PetStatus {
  PERDIDA
  AVISTADA
  ENCONTRADA
  REUNIDA
  EN_ADOPCION
  ARCHIVADA
}

enum SightingStatus {
  PENDIENTE
  CONFIRMADO
  DESCARTADO
}
