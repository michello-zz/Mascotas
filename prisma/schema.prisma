// Prisma schema — Mascotas: gestión de búsqueda de mascotas perdidas
// Vercel + PostgreSQL · Prisma 7
//
// Roles: DUENO (ve solo lo suyo) y ADMIN (acceso total).
// Datos del dueño: Nombre, Apellido, Correo, Teléfono, Comentarios.
// Datos de la mascota: ID (numérico autoincremental), Nombre, Especie, Dueño, Comentarios.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Usuarios (Better Auth) + datos del dueño / administrador
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String // requerido por Better Auth (se arma con Nombre + Apellido)
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Datos del dueño
  firstName String?
  lastName  String?
  phone     String?
  comments  String?

  role Role @default(DUENO)

  /// Un dueño nuevo queda pendiente hasta que el administrador lo acepte
  approved   Boolean   @default(false)
  approvedAt DateTime?

  sessions Session[]
  accounts Account[]
  pets     Pet[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Mascotas
// ─────────────────────────────────────────────────────────────

model Pet {
  /// Número único, autoincremental: es el que va en el QR y el que usa el sitio.
  id       Int     @id @default(autoincrement())
  name     String
  species  Species
  comments String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Estado de búsqueda
  /// true = está perdida y aparece en el listado público
  isLost      Boolean   @default(false)
  lostAt      DateTime?
  /// Comentario de cómo contactarse, que escribe el dueño al marcarla perdida
  lostComment String?
  foundAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([isLost])
  @@map("pet")
}

enum Role {
  DUENO
  ADMIN
}

enum Species {
  PERRO
  GATO
  OTRO
}
