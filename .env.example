# Copiar a .env y completar con los datos reales
#
# Neon entrega dos connection strings:
#   - POOLED  -> el hostname termina en "-pooler"  (la usa la app)
#   - DIRECT  -> el hostname NO tiene "-pooler"    (la usan las migraciones)
# Ambas usan el puerto 5432 y terminan en ?sslmode=require
#
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto de Better Auth: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL pública del sitio (en Vercel: https://tu-proyecto.vercel.app)
BETTER_AUTH_URL="http://localhost:3000"
