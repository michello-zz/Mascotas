# Copiar a .env y completar con los datos reales
# Neon / Vercel Postgres: usar la conexión con pooler para la app
DATABASE_URL="postgresql://usuario:password@host:6543/db?sslmode=require"
# Conexión directa (sin pooler), la usan las migraciones
DIRECT_URL="postgresql://usuario:password@host:5432/db?sslmode=require"
# Secreto de Better Auth: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública del sitio (en Vercel: la del proyecto)
BETTER_AUTH_URL="http://localhost:3000"
